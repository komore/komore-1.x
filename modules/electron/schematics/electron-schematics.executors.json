{
  "$schema": "https://komore.dev/json-schemas/schematics/executors.json",
  "build": {
    "description": "Builds an Electron application",
    "factory": "./src/executor/build/build-electron-application-executor#buildElectronApplicationExecutor"
  },
  "publish": {
    "description": "Publishes an Electron application",
    "factory": "./src/executor/publish/publish-electron-application-executor#signElectronApplicationExecutor"
  },
  "serve": {
    "description": "Serves an Electron application",
    "factory": "./src/executor/serve/serve-electron-application-executor#serveElectronApplicationExecutor"
  },
  "sign": {
    "description": "Signs an Electron application",
    "factory": "./src/executor/sign/sign-electron-application-executor#signElectronApplicationExecutor"
  }
}
