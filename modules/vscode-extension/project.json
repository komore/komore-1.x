{
  "root": "modules/vscode-extension",
  "sourceRoot": "modules/vscode-extension/src",
  "projectType": "library",
  "tags": ["scope:schematics", "trait:vscode"],
  "targets": {
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/vscode-extension",
        "tsConfig": "modules/vscode-extension/tsconfig.lib.json",
        "packageJson": "modules/vscode-extension/package.json",
        "main": "modules/vscode-extension/src/extension.ts",
        "assets": [
          "modules/vscode-extension/*.md",
          "modules/vscode-extension/package.json",
          "modules/vscode-extension/package.nls.json",
          {
            "glob": "**/*",
            "input": "modules/vscode-extension/assets/",
            "output": "./assets"
          },
          {
            "glob": "**/*",
            "input": "modules/vscode-extension/locales/",
            "output": "./locales"
          }
        ]
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/vscode-extension/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "modules/vscode-extension/jest.config.js",
        "passWithNoTests": true
      },
      "outputs": ["coverage/vscode-extension"]
    }
  }
}
