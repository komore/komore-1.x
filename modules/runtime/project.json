{
  "root": "modules/runtime",
  "sourceRoot": "modules/runtime/src",
  "projectType": "library",
  "tags": ["scope:runtime", "trait:base"],
  "targets": {
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/runtime",
        "tsConfig": "modules/runtime/tsconfig.lib.json",
        "packageJson": "modules/runtime/package.json",
        "main": "modules/runtime/src/index.ts",
        "assets": ["modules/runtime/*.md"]
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/runtime/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/runtime"],
      "options": {
        "jestConfig": "modules/runtime/jest.config.js",
        "passWithNoTests": true
      }
    }
  }
}
