{
  "root": "modules/runtime/node",
  "sourceRoot": "modules/runtime/node/src",
  "projectType": "library",
  "tags": ["scope:runtime", "environment:node"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/runtime/node/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/runtime-node"],
      "options": {
        "jestConfig": "modules/runtime/node/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/runtime/node",
        "tsConfig": "modules/runtime/node/tsconfig.lib.json",
        "packageJson": "modules/runtime/node/package.json",
        "main": "modules/runtime/node/src/index.ts"
      }
    }
  }
}
