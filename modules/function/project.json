{
  "root": "modules/function",
  "sourceRoot": "modules/function/src",
  "projectType": "library",
  "tags": ["scope:function", "trait:base"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/function/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "modules/function/jest.config.js",
        "passWithNoTests": true
      },
      "outputs": ["coverage/function"]
    },
    "build": {
      "executor": "@nrwl/node:package",
      "options": {
        "outputPath": "dist/function",
        "tsConfig": "modules/function/tsconfig.lib.json",
        "packageJson": "modules/function/package.json",
        "main": "modules/function/src/index.ts",
        "assets": ["modules/function/*.md"]
      },
      "outputs": ["{options.outputPath}"]
    }
  }
}
