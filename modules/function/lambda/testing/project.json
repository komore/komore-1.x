{
  "root": "modules/function/lambda/testing",
  "sourceRoot": "modules/function/lambda/testing/src",
  "projectType": "library",
  "tags": ["scope:function", "trait:provider", "trait:testing", "provider:amazon"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/function/lambda/testing/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "modules/function/lambda/testing/jest.config.js",
        "passWithNoTests": true,
        "tsConfig": "modules/function/lambda/testing/tsconfig.spec.json"
      },
      "outputs": ["coverage/function-lambda-testing"]
    },
    "build": {
      "executor": "@nrwl/node:package",
      "options": {
        "outputPath": "dist/function/lambda/testing",
        "tsConfig": "modules/function/lambda/testing/tsconfig.lib.json",
        "packageJson": "modules/function/lambda/testing/package.json",
        "main": "modules/function/lambda/testing/src/index.ts"
      },
      "outputs": ["{options.outputPath}"]
    }
  }
}
