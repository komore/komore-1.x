{
  "root": "modules/function/lambda/cognito",
  "sourceRoot": "modules/function/lambda/cognito/src",
  "projectType": "library",
  "tags": ["scope:function", "trait:provider", "provider:amazon", "service:cognito"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/function/lambda/cognito/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "modules/function/lambda/cognito/jest.config.js",
        "passWithNoTests": true,
        "tsConfig": "modules/function/lambda/cognito/tsconfig.spec.json"
      },
      "outputs": ["coverage/function-lambda-cognito"]
    },
    "build": {
      "executor": "@nrwl/node:package",
      "options": {
        "outputPath": "dist/function/lambda/cognito",
        "tsConfig": "modules/function/lambda/cognito/tsconfig.lib.json",
        "packageJson": "modules/function/lambda/cognito/package.json",
        "main": "modules/function/lambda/cognito/src/index.ts"
      },
      "outputs": ["{options.outputPath}"]
    }
  }
}
