{
  "root": "modules/function/alicloud",
  "sourceRoot": "modules/function/alicloud/src",
  "projectType": "library",
  "tags": ["scope:function", "trait:provider", "provider:alicloud"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/function/alicloud/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "modules/function/alicloud/jest.config.js",
        "passWithNoTests": true,
        "tsConfig": "modules/function/alicloud/tsconfig.spec.json"
      },
      "outputs": ["coverage/function-alicloud"]
    },
    "build": {
      "executor": "@nrwl/node:package",
      "options": {
        "outputPath": "dist/function/alicloud",
        "tsConfig": "modules/function/alicloud/tsconfig.lib.json",
        "packageJson": "modules/function/alicloud/package.json",
        "main": "modules/function/alicloud/src/index.ts",
        "assets": ["modules/function/alicloud/*.md"]
      },
      "outputs": ["{options.outputPath}"]
    }
  }
}
