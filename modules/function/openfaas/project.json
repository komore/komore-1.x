{
  "root": "modules/function/openfaas",
  "sourceRoot": "modules/function/openfaas/src",
  "projectType": "library",
  "tags": ["scope:function", "trait:provider", "provider:openfaas"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/function/openfaas/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "modules/function/openfaas/jest.config.js",
        "passWithNoTests": true
      },
      "outputs": ["coverage/function-openfaas"]
    },
    "build": {
      "executor": "@nrwl/node:package",
      "options": {
        "outputPath": "dist/function/openfaas",
        "tsConfig": "modules/function/openfaas/tsconfig.lib.json",
        "packageJson": "modules/function/openfaas/package.json",
        "main": "modules/function/openfaas/src/index.ts",
        "assets": ["modules/function/openfaas/*.md"]
      },
      "outputs": ["{options.outputPath}"]
    }
  }
}
