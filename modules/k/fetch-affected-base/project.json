{
  "root": "modules/cli/fetch-affected-base",
  "sourceRoot": "modules/cli/fetch-affected-base/src",
  "projectType": "library",
  "tags": ["scope:cli"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/cli/fetch-affected-base/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/cli-fetchaffectedbase"],
      "options": {
        "jestConfig": "modules/cli/fetch-affected-base/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/cli/fetch-affected-base",
        "tsConfig": "modules/cli/fetch-affected-base/tsconfig.lib.json",
        "packageJson": "modules/cli/fetch-affected-base/package.json",
        "main": "modules/cli/fetch-affected-base/src/index.ts"
      }
    }
  }
}
