{
  "root": "modules/cli/build",
  "sourceRoot": "modules/cli/build/src",
  "projectType": "library",
  "tags": ["scope:cli"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/cli/build/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/cli-build"],
      "options": {
        "jestConfig": "modules/cli/build/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/cli/build",
        "tsConfig": "modules/cli/build/tsconfig.lib.json",
        "packageJson": "modules/cli/build/package.json",
        "main": "modules/cli/build/src/index.ts"
      }
    }
  }
}
