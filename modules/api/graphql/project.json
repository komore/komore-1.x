{
  "root": "modules/api/graphql",
  "sourceRoot": "modules/api/graphql/src",
  "projectType": "library",
  "generators": {},
  "tags": ["scope:api"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/api/graphql/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "modules/api/graphql/jest.config.js",
        "passWithNoTests": true,
        "tsConfig": "modules/api/graphql/tsconfig.spec.json"
      },
      "outputs": ["coverage/api-graphql"]
    },
    "build": {
      "executor": "@nrwl/node:package",
      "options": {
        "outputPath": "dist/api/graphql",
        "tsConfig": "modules/api/graphql/tsconfig.lib.json",
        "packageJson": "modules/api/graphql/package.json",
        "main": "modules/api/graphql/src/index.ts",
        "assets": ["modules/api/graphql/*.md"]
      },
      "outputs": ["{options.outputPath}"]
    }
  }
}
