{
  "root": "modules/storybook",
  "sourceRoot": "modules/storybook/src",
  "projectType": "library",
  "tags": ["scope:storybook", "trait:base"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/storybook/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/storybook"],
      "options": {
        "jestConfig": "modules/storybook/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/storybook",
        "tsConfig": "modules/storybook/tsconfig.lib.json",
        "packageJson": "modules/storybook/package.json",
        "main": "modules/storybook/src/index.ts",
        "assets": ["modules/storybook/*.md"]
      }
    }
  }
}
