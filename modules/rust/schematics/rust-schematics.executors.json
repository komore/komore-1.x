{
  "$schema": "https://komore.dev/json-schemas/schematics/executors.json",
  "build": {
    "defaultTask": "@komore/rust/schematics#createRustModuleBuildDefaultTask",
    "description": "Builds a Rust application or library",
    "documentation": "https://komore.dev/modules/rust/schematics/executors/build",
    "factory": "@komore/rust/schematics#buildRustModuleExecutor",
    "options": {
      "processor": "@komore/rust/schematics#createBuildRustModuleExecutorOptionsProcessor",
      "schema": "./src/executor/build/build-rust-module-executor-options.schema.json"
    }
  },
  "document": {
    "description": "Generate Rust code documentation",
    "documentation": "https://komore.dev/modules/rust/schematics/executors/document"
  },
  "fix": {
    "description": "Fix Rust code using rustfix",
    "documentation": "https://komore.dev/modules/rust/schematics/executors/fix",
    "implementation": "./src/executors/fix/fix-executor",
    "schema": "./src/executors/format/fix-schema.json"
  },
  "format": {
    "description": "Format Rust code using rustfmt",
    "documentation": "https://komore.dev/modules/rust/schematics/executors/format",
    "implementation": "./src/executors/format/format-executor",
    "schema": "./src/executors/format/format-schema.json"
  },
  "lint": {
    "description": "Lint Rust code",
    "documentation": "https://komore.dev/modules/rust/schematics/executors/lint",
    "implementation": "./src/executors/lint/lint-executor",
    "schema": "./src/executors/lint/lint-schema.json"
  },
  "test": {
    "description": "Execute Rust unit tests",
    "documentation": "https://komore.dev/modules/rust/schematics/executors/test",
    "factory": "@komore/rust/schematics#testRustModuleExecutor",
    "options": {
      "schema": "./src/executor/test/test-rust-module-executor-options.schema.json"
    }
  }
}
