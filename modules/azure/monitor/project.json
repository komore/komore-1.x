{
  "root": "modules/integration/azure/monitor",
  "sourceRoot": "modules/integration/azure/monitor/src",
  "projectType": "library",
  "generators": {},
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/integration/azure/monitor/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "modules/integration/azure/monitor/jest.config.js",
        "passWithNoTests": true
      },
      "outputs": ["coverage/integration-azure-monitor"]
    },
    "build": {
      "executor": "@nrwl/node:package",
      "options": {
        "outputPath": "dist/integration/azure/monitor",
        "tsConfig": "modules/integration/azure/monitor/tsconfig.lib.json",
        "packageJson": "modules/integration/azure/monitor/package.json",
        "main": "modules/integration/azure/monitor/src/index.ts",
        "assets": ["modules/integration/azure/monitor/*.md"]
      },
      "outputs": ["{options.outputPath}"]
    }
  }
}
