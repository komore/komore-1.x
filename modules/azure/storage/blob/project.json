{
  "root": "modules/integration/azure/storage/blob",
  "sourceRoot": "modules/integration/azure/storage/blob/src",
  "projectType": "library",
  "tags": ["scope:integration", "trait:provider", "provider:azure"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/integration/azure/storage/blob/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "modules/integration/azure/storage/blob/jest.config.js",
        "passWithNoTests": true
      },
      "outputs": ["coverage/integration-azure-storage-blob"]
    },
    "build": {
      "executor": "@nrwl/node:package",
      "options": {
        "outputPath": "dist/integration/azure/storage/blob",
        "tsConfig": "modules/integration/azure/storage/blob/tsconfig.lib.json",
        "packageJson": "modules/integration/azure/storage/blob/package.json",
        "main": "modules/integration/azure/storage/blob/src/index.ts"
      },
      "outputs": ["{options.outputPath}"]
    }
  }
}
