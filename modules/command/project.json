{
  "root": "modules/command",
  "sourceRoot": "modules/command/src",
  "projectType": "library",
  "tags": ["scope:command", "trait:base"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/command/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/command"],
      "options": {
        "jestConfig": "modules/command/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/command",
        "tsConfig": "modules/command/tsconfig.lib.json",
        "packageJson": "modules/command/package.json",
        "main": "modules/command/src/index.ts",
        "assets": ["modules/command/*.md"]
      }
    },
    "publish": {
      "executor": "@komore/nx:publish",
      "options": {
        "buildTarget": ["integration-command:build", "integration-command-testing:build"]
      }
    }
  }
}
