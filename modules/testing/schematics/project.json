{
  "root": "modules/testing/schematics",
  "sourceRoot": "modules/testing/schematics/src",
  "projectType": "library",
  "tags": ["scope:testing", "trait:testing", "trait:schematics"],
  "targets": {
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/testing/schematics",
        "tsConfig": "modules/testing/schematics/tsconfig.lib.json",
        "packageJson": "modules/testing/schematics/package.json",
        "main": "modules/testing/schematics/src/index.ts",
        "assets": ["modules/testing/schematics/executors.json", "modules/testing/schematics/generators.json"]
      }
    },
    "lint": {
      "executor": "@nrwl/linter:schematics",
      "options": {
        "lintFilePatterns": ["modules/testing/schematics/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/testing-schematics"],
      "options": {
        "jestConfig": "modules/testing/schematics/jest.config.js",
        "passWithNoTests": true
      }
    }
  }
}
