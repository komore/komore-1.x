{
  "$schema": "https://komore.dev/json-schemas/schematics/executors.json",
  "merge": {
    "defaultTask": "@komore/testing/schematics#createLintModuleDefaultTask",
    "description": "Merges test results",
    "documentation": "https://komore.dev/modules/testing/schematics/executors/merge",
    "factory": "@komore/testing/schematics#createMergeTestExecutor",
    "options": {
      "processor": "@komore/testing/schematics#createMergeTestExecutorOptionsProcessor",
      "schema": "./src/executor/merge/merge-test-result-executor-options.schema.json"
    }
  },
  "publish": {
    "defaultTask": "@komore/testing/schematics#createLintModuleDefaultTask",
    "description": "Publishes test results",
    "documentation": "https://komore.dev/modules/testing/schematics/executors/publish",
    "factory": "@komore/testing/schematics#createPublishTestExecutor",
    "options": {
      "processor": "@komore/testing/schematics#creatPublishTestExecutorOptionsProcessor",
      "schema": "./src/executor/publish/publish-test-result-executor-options.schema.json"
    }
  },
  "test": {
    "defaultTask": "@komore/testing/schematics#createTestModuleDefaultTask",
    "description": "Tests a module",
    "documentation": "https://komore.dev/modules/testing/schematics/executors/test",
    "factory": "@komore/testing/schematics#createTestModuleExecutor",
    "options": {
      "processor": "@komore/testing/schematics#createTestModuleExecutorOptionsProcessor",
      "schema": "./src/executor/test/test-module-executor-options.schema.json"
    }
  }
}
