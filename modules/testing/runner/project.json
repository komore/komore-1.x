{
  "root": "modules/testing/runner",
  "sourceRoot": "modules/testing/runner/src",
  "projectType": "library",
  "tags": ["scope:testing", "trait:testing", "trait:runner"],
  "targets": {
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/testing/runner",
        "tsConfig": "modules/testing/runner/tsconfig.lib.json",
        "packageJson": "modules/testing/runner/package.json",
        "main": "modules/testing/runner/src/index.ts"
      }
    },
    "lint": {
      "executor": "@nrwl/linter:runner",
      "options": {
        "lintFilePatterns": ["modules/testing/runner/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/testing-runner"],
      "options": {
        "jestConfig": "modules/testing/runner/jest.config.js",
        "passWithNoTests": true
      }
    }
  }
}
