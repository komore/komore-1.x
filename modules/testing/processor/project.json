{
  "root": "modules/testing/processor",
  "sourceRoot": "modules/testing/processor/src",
  "projectType": "library",
  "tags": ["scope:testing", "trait:testing", "trait:processor"],
  "targets": {
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/testing/processor",
        "tsConfig": "modules/testing/processor/tsconfig.lib.json",
        "packageJson": "modules/testing/processor/package.json",
        "main": "modules/testing/processor/src/index.ts"
      }
    },
    "lint": {
      "executor": "@nrwl/linter:processor",
      "options": {
        "lintFilePatterns": ["modules/testing/processor/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/testing-processor"],
      "options": {
        "jestConfig": "modules/testing/processor/jest.config.js",
        "passWithNoTests": true
      }
    }
  }
}
