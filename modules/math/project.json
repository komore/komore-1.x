{
  "root": "modules/math",
  "sourceRoot": "modules/math/src",
  "projectType": "library",
  "tags": ["scope:math", "trait:base"],
  "targets": {
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/math",
        "tsConfig": "modules/math/tsconfig.lib.json",
        "packageJson": "modules/math/package.json",
        "main": "modules/math/src/index.ts",
        "assets": ["modules/math/*.md"]
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/math/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/math"],
      "options": {
        "jestConfig": "modules/math/jest.config.js",
        "passWithNoTests": true
      }
    }
  }
}
