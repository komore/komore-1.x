{
  "root": "modules/lint",
  "sourceRoot": "modules/lint/src",
  "projectType": "library",
  "tags": ["scope:lint", "trait:base"],
  "targets": {
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/lint",
        "tsConfig": "modules/lint/tsconfig.lib.json",
        "packageJson": "modules/lint/package.json",
        "main": "modules/lint/src/index.ts",
        "assets": ["modules/lint/*.md"]
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/lint/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/lint"],
      "options": {
        "jestConfig": "modules/lint/jest.config.js",
        "passWithNoTests": true
      }
    }
  }
}
