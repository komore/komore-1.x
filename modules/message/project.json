{
  "root": "modules/message",
  "sourceRoot": "modules/message/src",
  "projectType": "library",
  "tags": ["scope:message", "trait:base"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/message/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "modules/message/jest.config.js",
        "passWithNoTests": true,
        "tsConfig": "modules/message/tsconfig.spec.json"
      },
      "outputs": ["coverage/message"]
    },
    "build": {
      "executor": "@nrwl/node:package",
      "options": {
        "outputPath": "dist/message",
        "tsConfig": "modules/message/tsconfig.lib.json",
        "packageJson": "modules/message/package.json",
        "main": "modules/message/src/index.ts",
        "assets": ["modules/message/*.md"]
      },
      "outputs": ["{options.outputPath}"]
    }
  }
}
