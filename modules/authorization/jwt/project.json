{
  "root": "modules/authorization/jwt",
  "sourceRoot": "modules/authorization/jwt/src",
  "projectType": "library",
  "tags": ["scope:authorization"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/authorization/jwt/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/authorization-jwt"],
      "options": {
        "jestConfig": "modules/authorization/jwt/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/authorization/jwt",
        "tsConfig": "modules/authorization/jwt/tsconfig.lib.json",
        "packageJson": "modules/authorization/jwt/package.json",
        "main": "modules/authorization/jwt/src/index.ts"
      }
    }
  }
}
