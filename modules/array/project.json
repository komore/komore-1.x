{
  "root": "modules/array",
  "sourceRoot": "modules/array/src",
  "projectType": "library",
  "tags": ["scope:array", "trait:base"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/array/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/array"],
      "options": {
        "jestConfig": "modules/array/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/array",
        "tsConfig": "modules/array/tsconfig.lib.json",
        "packageJson": "modules/array/package.json",
        "main": "modules/array/src/index.ts",
        "assets": ["modules/array/*.md"]
      }
    }
  }
}
