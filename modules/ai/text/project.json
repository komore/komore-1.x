{
  "root": "modules/ai/text",
  "sourceRoot": "modules/ai/text/src",
  "projectType": "library",
  "generators": {},
  "tags": ["scope:ai"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/ai/text/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "modules/ai/text/jest.config.js",
        "passWithNoTests": true,
        "tsConfig": "modules/ai/text/tsconfig.spec.json"
      },
      "outputs": ["coverage/ai-text"]
    },
    "build": {
      "executor": "@nrwl/node:package",
      "options": {
        "outputPath": "dist/ai/text",
        "tsConfig": "modules/ai/text/tsconfig.lib.json",
        "packageJson": "modules/ai/text/package.json",
        "main": "modules/ai/text/src/index.ts"
      },
      "outputs": ["{options.outputPath}"]
    }
  }
}
