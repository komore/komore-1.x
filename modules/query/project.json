{
  "root": "modules/query",
  "sourceRoot": "modules/query/src",
  "projectType": "library",
  "tags": ["scope:query", "trait:base"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/query/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/query"],
      "options": {
        "jestConfig": "modules/query/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/query",
        "tsConfig": "modules/query/tsconfig.lib.json",
        "packageJson": "modules/query/package.json",
        "main": "modules/query/src/index.ts",
        "assets": ["modules/query/*.md"]
      }
    }
  }
}
