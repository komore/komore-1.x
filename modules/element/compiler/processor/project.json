{
  "root": "modules/element/compiler/processor",
  "sourceRoot": "modules/element/compiler/processor/src",
  "projectType": "library",
  "tags": ["scope:element"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/element/compiler/processor/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/element-compiler-processor"],
      "options": {
        "jestConfig": "modules/element/compiler/processor/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/element-compiler-processor",
        "tsConfig": "modules/element/compiler/processor/tsconfig.lib.json",
        "packageJson": "modules/element/compiler/processor/package.json",
        "main": "modules/element/compiler/processor/src/index.ts"
      }
    }
  }
}
