{
  "root": "modules/element/ssr",
  "sourceRoot": "modules/element/ssr/src",
  "projectType": "library",
  "tags": ["scope:element"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/element/ssr/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/element-ssr"],
      "options": {
        "jestConfig": "modules/element/ssr/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/element/ssr",
        "tsConfig": "modules/element/ssr/tsconfig.lib.json",
        "packageJson": "modules/element/ssr/package.json",
        "main": "modules/element/ssr/src/index.ts",
        "assets": ["modules/element/ssr/README.md"]
      }
    }
  }
}
