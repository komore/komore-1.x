{
  "root": "modules/element/directive/if",
  "sourceRoot": "modules/element/directive/if/src",
  "projectType": "library",
  "tags": ["scope:element", "trait:directive"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/element/directive/if/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/element-directive-if"],
      "options": {
        "jestConfig": "modules/element/directive/if/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/element/directive/if",
        "tsConfig": "modules/element/directive/if/tsconfig.lib.json",
        "packageJson": "modules/element/directive/if/package.json",
        "main": "modules/element/directive/if/src/index.ts"
      }
    }
  }
}
