{
  "root": "modules/element/directive/class",
  "sourceRoot": "modules/element/directive/class/src",
  "projectType": "library",
  "tags": ["scope:element", "trait:directive"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/element/directive/class/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/element-directive-class"],
      "options": {
        "jestConfig": "modules/element/directive/class/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/element/directive/class",
        "tsConfig": "modules/element/directive/class/tsconfig.lib.json",
        "packageJson": "modules/element/directive/class/package.json",
        "main": "modules/element/directive/class/src/index.ts"
      }
    }
  }
}
