{
  "root": "modules/bot/stack",
  "sourceRoot": "modules/bot/stack/src",
  "projectType": "application",
  "tags": ["scope:bot", "trait:stack"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/bot/stack/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/bot-stack"],
      "options": {
        "jestConfig": "modules/bot/stack/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/bot/stack",
        "tsConfig": "modules/bot/stack/tsconfig.lib.json",
        "packageJson": "modules/bot/stack/package.json",
        "main": "modules/bot/stack/src/index.ts"
      }
    }
  }
}
