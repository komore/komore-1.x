{
  "$schema": "https://komore.dev/json-schemas/schematics/executors.json",
  "build-browser-application": {
    "defaultTask": "@komore/browser/schematics#createBuildBrowserApplicationDefaultTask",
    "description": "Builds a browser application",
    "documentation": "https://komore.dev/modules/browser/schematics/executors/build-browser-application",
    "factory": "@komore/browser/schematics#createBuildBrowserApplicationExecutor",
    "options": {
      "processor": "@komore/browser/schematics#createBuildBrowserApplicationExecutorOptionsProcessor",
      "schema": "./src/executor/build/build-browser-application-executor-options.schema.json"
    }
  },
  "serve-browser-application": {
    "defaultTask": "@komore/browser/schematics#createServeBrowserApplicationDefaultTask",
    "description": "Serves a browser application",
    "documentation": "https://komore.dev/modules/browser/schematics/executors/serve-browser-application",
    "factory": "@komore/browser/schematics#createServeBrowserApplicationExecutor",
    "options": {
      "processor": "@komore/browser/schematics#createServeBrowserApplicationExecutorOptionsProcessor",
      "schema": "./src/executor/serve/serve-browser-application-executor-options.schema.json"
    }
  }
}
