{
  "projectType": "library",
  "root": "modules/cicd/provider",
  "sourceRoot": "modules/cicd/provider/src",
  "tags": ["scope:cicd", "trait:provider", "provider:provider"],
  "targets": {
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/cicd/provider",
        "tsConfig": "modules/cicd/provider/tsconfig.lib.json",
        "packageJson": "modules/cicd/provider/package.json",
        "main": "modules/cicd/provider/src/index.ts"
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/cicd/provider/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/cicd-provider"],
      "options": {
        "jestConfig": "modules/cicd/provider/jest.config.js",
        "passWithNoTests": true
      }
    }
  }
}
