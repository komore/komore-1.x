{
  "projectType": "library",
  "root": "modules/cicd/gitlab",
  "sourceRoot": "modules/cicd/gitlab/src",
  "tags": ["scope:cicd", "trait:provider", "provider:gitlab"],
  "targets": {
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/cicd-gitlab",
        "tsConfig": "modules/cicd/gitlab/tsconfig.lib.json",
        "packageJson": "modules/cicd/gitlab/package.json",
        "main": "modules/cicd/gitlab/src/index.ts",
        "assets": ["modules/cicd/gitlab/*.md"]
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/cicd/gitlab/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/cicd-gitlab"],
      "options": {
        "jestConfig": "modules/cicd/gitlab/jest.config.js",
        "passWithNoTests": true
      }
    }
  }
}
