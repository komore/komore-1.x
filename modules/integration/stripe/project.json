{
  "root": "modules/integration/stripe",
  "sourceRoot": "modules/integration/stripe/src",
  "projectType": "library",
  "tags": ["scope:integration", "trait:provider", "provider:stripe"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/integration/stripe/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "modules/integration/stripe/jest.config.js",
        "passWithNoTests": true,
        "tsConfig": "modules/integration/stripe/tsconfig.spec.json"
      },
      "outputs": ["coverage/integration-stripe"]
    },
    "build": {
      "executor": "@nrwl/node:package",
      "options": {
        "outputPath": "dist/integration-stripe",
        "tsConfig": "modules/integration/stripe/tsconfig.lib.json",
        "packageJson": "modules/integration/stripe/package.json",
        "main": "modules/integration/stripe/src/index.ts",
        "assets": ["modules/integration/stripe/*.md"]
      },
      "outputs": ["{options.outputPath}"]
    }
  }
}
