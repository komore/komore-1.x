{
  "root": "modules/integration/amazon/polly",
  "sourceRoot": "modules/integration/amazon/polly/src",
  "projectType": "library",
  "tags": ["scope:integration", "trait:provider", "provider:amazon"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/integration/amazon/polly/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "modules/integration/amazon/polly/jest.config.js",
        "passWithNoTests": true
      },
      "outputs": ["coverage/integration-amazon-polly"]
    },
    "build": {
      "executor": "@nrwl/node:package",
      "options": {
        "outputPath": "dist/integration/amazon/polly",
        "tsConfig": "modules/integration/amazon/polly/tsconfig.lib.json",
        "packageJson": "modules/integration/amazon/polly/package.json",
        "main": "modules/integration/amazon/polly/src/index.ts",
        "assets": ["modules/integration/amazon/polly/*.md"]
      },
      "outputs": ["{options.outputPath}"]
    }
  }
}
