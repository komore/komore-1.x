{
  "root": "modules/integration/gumroad",
  "sourceRoot": "modules/integration/gumroad/src",
  "projectType": "library",
  "tags": ["scope:integration", "trait:provider", "provider:gumroad"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/integration/gumroad/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/integration-gumroad"],
      "options": {
        "jestConfig": "modules/integration/gumroad/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/integration/gumroad",
        "tsConfig": "modules/integration/gumroad/tsconfig.lib.json",
        "packageJson": "modules/integration/gumroad/package.json",
        "main": "modules/integration/gumroad/src/index.ts",
        "assets": ["modules/integration/gumroad/*.md"]
      }
    }
  }
}
