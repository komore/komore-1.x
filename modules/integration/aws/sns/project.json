{
  "root": "modules/integration/aws/sns",
  "sourceRoot": "modules/integration/aws/sns/src",
  "projectType": "library",
  "tags": ["scope:integration", "trait:provider", "provider:aws"],
  "targets": {
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/integration/aws/sns",
        "tsConfig": "modules/integration/aws/sns/tsconfig.lib.json",
        "packageJson": "modules/integration/aws/sns/package.json",
        "main": "modules/integration/aws/sns/src/index.ts"
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/integration/aws/sns/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/integration-aws-sns"],
      "options": {
        "jestConfig": "modules/integration/aws/sns/jest.config.js",
        "passWithNoTests": true
      }
    }
  }
}
