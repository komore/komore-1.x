{
  "root": "modules/integration/amazon/comprehend",
  "sourceRoot": "modules/integration/amazon/comprehend/src",
  "projectType": "library",
  "tags": ["scope:integration", "trait:provider", "provider:amazon"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/integration/amazon/comprehend/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "modules/integration/amazon/comprehend/jest.config.js",
        "passWithNoTests": true
      },
      "outputs": ["coverage/integration-amazon-comprehend"]
    },
    "build": {
      "executor": "@nrwl/node:package",
      "options": {
        "outputPath": "dist/integration/amazon/comprehend",
        "tsConfig": "modules/integration/amazon/comprehend/tsconfig.lib.json",
        "packageJson": "modules/integration/amazon/comprehend/package.json",
        "main": "modules/integration/amazon/comprehend/src/index.ts",
        "assets": ["modules/integration/amazon/comprehend/*.md"]
      },
      "outputs": ["{options.outputPath}"]
    }
  }
}
