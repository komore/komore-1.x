{
  "root": "modules/integration/azure",
  "sourceRoot": "modules/integration/azure/src",
  "projectType": "library",
  "tags": ["scope:integration", "trait:provider", "provider:azure"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/integration/azure/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "modules/integration/azure/jest.config.js",
        "passWithNoTests": true
      },
      "outputs": ["coverage/integration-azure"]
    },
    "build": {
      "executor": "@nrwl/node:package",
      "options": {
        "outputPath": "dist/integration/azure",
        "tsConfig": "modules/integration/azure/tsconfig.lib.json",
        "packageJson": "modules/integration/azure/package.json",
        "main": "modules/integration/azure/src/index.ts",
        "assets": ["modules/integration/azure/*.md"]
      },
      "outputs": ["{options.outputPath}"]
    }
  }
}
