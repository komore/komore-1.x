{
  "$schema": "https://komore.dev/json-schemas/schematics/executors.json",
  "build": {
    "defaultTask": "@komore/node/schematics#createBuildNodeModuleDefaultTask",
    "description": "Builds a Node module",
    "documentation": "https://komore.dev/modules/node/schematics/executors/build",
    "factory": "@komore/node/schematics#createBuildNodeModuleExecutor",
    "options": {
      "processor": "@komore/node/schematics#createBuildNodeModuleExecutorOptionsProcessor",
      "schema": "./src/executor/build/build-module-executor-options.schema.json"
    }
  },
  "package": {
    "defaultTask": "@komore/node/schematics#createPackageNodeModuleDefaultTask",
    "description": "Packages a Node module",
    "documentation": "https://komore.dev/modules/node/schematics/executors/package",
    "factory": "@komore/node/schematics#createPackageNodeModuleExecutor",
    "options": {
      "processor": "@komore/node/schematics#createPackageNodeModuleExecutorOptionsProcessor",
      "schema": "./src/executor/package/package-node-module-executor-options.schema.json"
    }
  },
  "publish": {
    "defaultTask": "@komore/node/schematics#createPublishNodeModuleDefaultTask",
    "description": "Publishes a Node module",
    "documentation": "https://komore.dev/modules/schematics/executors/publish",
    "factory": "@komore/node/schematics#createPublishNodeModuleExecutor",
    "options": {
      "processor": "@komore/schematics#publishModuleExecutorOptionsProcessor",
      "schema": "./src/executor/publish/publish-node-module-executor-options.schema.json"
    }
  },
  "serve": {
    "defaultTask": "@komore/node/schematics#createServeNodeModuleDefaultTask",
    "description": "Serves a Node module",
    "documentation": "https://komore.dev/modules/node/schematics/serve",
    "factory": "@komore/node/schematics#createServeNodeModuleExecutor",
    "options": {
      "processor": "@komore/node/schematics#createBuildNodeModuleExecutorOptionsProcessor",
      "schema": "./src/executor/serve-node-module-executor-options.schema.json"
    }
  },
  "sign": {
    "defaultTask": "@komore/node/schematics#createSignNodeModuleDefaultTask",
    "description": "Signs a Node module",
    "documentation": "https://komore.dev/modules/node/schematics/sign",
    "factory": "@komore/node/schematics#createSignNodeModuleExecutor",
    "options": {
      "processor": "@komore/node/schematics#createBuildNodeModuleExecutorOptionsProcessor",
      "schema": "./src/executor/sign-node-module-executor-options.schema.json"
    }
  }
}
