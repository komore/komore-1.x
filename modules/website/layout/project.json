{
  "root": "modules/website/layout",
  "sourceRoot": "modules/website/layout/src",
  "projectType": "library",
  "tags": ["scope:website"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/website/layout/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "modules/website/layout/jest.config.js",
        "passWithNoTests": true
      },
      "outputs": ["coverage/website-layout"]
    },
    "build": {
      "executor": "@nrwl/node:package",
      "options": {
        "outputPath": "dist/website/layout",
        "tsConfig": "modules/website/layout/tsconfig.lib.json",
        "packageJson": "modules/website/layout/package.json",
        "main": "modules/website/layout/src/index.ts",
        "assets": ["modules/website/layout/*.md"]
      },
      "outputs": ["{options.outputPath}"]
    }
  }
}
