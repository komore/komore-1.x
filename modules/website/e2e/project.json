{
  "root": "modules/website/e2e",
  "sourceRoot": "modules/website/e2e/src",
  "projectType": "application",
  "tags": ["scope:website"],
  "implicitDependencies": ["website"],
  "targets": {
    "e2e": {
      "executor": "@nrwl/cypress:cypress",
      "options": {
        "cypressConfig": "modules/website/e2e/cypress.json",
        "tsConfig": "modules/website/e2e/tsconfig.e2e.json",
        "devServerTarget": "website:serve"
      },
      "configurations": {
        "production": {
          "devServerTarget": "website:serve:production"
        }
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/website/e2e/src/**/*.ts"]
      }
    }
  }
}
