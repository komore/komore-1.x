{
  "root": "modules/string",
  "sourceRoot": "modules/string/src",
  "projectType": "library",
  "tags": ["scope:string", "trait:base"],
  "targets": {
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/string",
        "tsConfig": "modules/string/tsconfig.lib.json",
        "packageJson": "modules/string/package.json",
        "main": "modules/string/src/index.ts"
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/string/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/string"],
      "options": {
        "jestConfig": "modules/string/jest.config.js",
        "passWithNoTests": true
      }
    }
  }
}
