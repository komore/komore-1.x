{
  "root": "modules/web/http/websocket",
  "sourceRoot": "modules/web/http/websocket/src",
  "projectType": "library",
  "tags": ["scope:web"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/web/http/websocket/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/web-http-websocket"],
      "options": {
        "jestConfig": "modules/web/http/websocket/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/web/http/websocket",
        "tsConfig": "modules/web/http/websocket/tsconfig.lib.json",
        "packageJson": "modules/web/http/websocket/package.json",
        "main": "modules/web/http/websocket/src/index.ts"
      }
    }
  }
}
