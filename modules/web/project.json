{
  "root": "modules/web",
  "sourceRoot": "modules/web/src",
  "projectType": "library",
  "tags": ["scope:web", "trait:base"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/web/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/web"],
      "options": {
        "jestConfig": "modules/web/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/web",
        "tsConfig": "modules/web/tsconfig.lib.json",
        "packageJson": "modules/web/package.json",
        "main": "modules/web/src/index.ts",
        "assets": ["modules/web/*.md"]
      }
    }
  }
}
