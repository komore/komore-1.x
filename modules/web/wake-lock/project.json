{
  "root": "modules/web/wake-lock",
  "sourceRoot": "modules/web/wake-lock/src",
  "projectType": "library",
  "tags": ["scope:web"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/web/wake-lock/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/web-wakelock"],
      "options": {
        "jestConfig": "modules/web/wake-lock/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/web/wake-lock",
        "tsConfig": "modules/web/wake-lock/tsconfig.lib.json",
        "packageJson": "modules/web/wake-lock/package.json",
        "main": "modules/web/wake-lock/src/index.ts"
      }
    }
  }
}
