{
  "root": "modules/application/tauri/schematics",
  "sourceRoot": "modules/application/tauri/schematics/src",
  "projectType": "library",
  "tags": ["scope:application", "trait:schematics"],
  "targets": {
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/application-tauri/schematics",
        "tsConfig": "modules/application/tauri/schematics/tsconfig.lib.json",
        "packageJson": "modules/application/tauri/schematics/package.json",
        "main": "modules/application/tauri/schematics/src/index.ts",
        "assets": ["modules/application/tauri/schematics/*.md"]
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/application/tauri/schematics/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/application-tauri-schematics"],
      "options": {
        "jestConfig": "modules/application/tauri/schematics/jest.config.js",
        "passWithNoTests": true
      }
    }
  }
}
