{
  "root": "modules/application/updater",
  "sourceRoot": "modules/application/updater/src",
  "projectType": "library",
  "tags": ["scope:application"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/application/updater/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/application-updater"],
      "options": {
        "jestConfig": "modules/application/updater/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/application/updater",
        "tsConfig": "modules/application/tsconfig.lib.json",
        "packageJson": "modules/application/updater/package.json",
        "main": "modules/application/updater/src/index.ts",
        "assets": ["modules/application/updater/*.md"]
      }
    }
  }
}
