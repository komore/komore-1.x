{
  "root": "modules/application",
  "sourceRoot": "modules/application/src",
  "projectType": "library",
  "generators": {},
  "tags": ["scope:application", "trait:base"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/application/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "modules/application/jest.config.js",
        "passWithNoTests": true
      },
      "outputs": ["coverage/application"]
    },
    "build": {
      "executor": "@nrwl/node:package",
      "options": {
        "outputPath": "dist/application",
        "tsConfig": "modules/application/tsconfig.lib.json",
        "packageJson": "modules/application/package.json",
        "main": "modules/application/src/index.ts",
        "assets": ["modules/application/*.md"]
      },
      "outputs": ["{options.outputPath}"]
    }
  }
}
