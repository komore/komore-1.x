{
  "root": "modules/payment",
  "sourceRoot": "modules/payment/src",
  "projectType": "library",
  "tags": ["scope:payment", "trait:base"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/payment/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/payment"],
      "options": {
        "jestConfig": "modules/payment/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/payment",
        "tsConfig": "modules/payment/tsconfig.lib.json",
        "packageJson": "modules/payment/package.json",
        "main": "modules/payment/src/index.ts",
        "assets": ["modules/payment/*.md"]
      }
    }
  }
}
