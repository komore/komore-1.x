{
  "$schema": "https://komore.dev/json-schemas/schematics/executors",
  "build": {
    "defaultTask": "@komore/schematics/build#createBuildModuleDefaultTask",
    "description": "Builds a module",
    "documentation": "https://komore.dev/modules/schematics/build",
    "factory": "@komore/schematics/build#createBuildModuleExecutor",
    "options": {
      "processor": "@komore/schematics#buildModuleExecutorOptionsProcessor",
      "schema": "./build/src/build-module-executor-options.schema.json"
    }
  },
  "package": {
    "defaultTask": "@komore/schematics#createPackageModuleDefaultTask",
    "description": "Packages a module",
    "documentation": "https://komore.dev/modules/schematics/executors/package",
    "factory": "@komore/schematics#createPackageModuleExecutor",
    "options": {
      "processor": "@komore/schematics#packageModuleExecutorOptionsProcessor",
      "schema": "./src/executor/package/package-module-executor-options.schema.json"
    }
  },
  "publish": {
    "defaultTask": "@komore/schematics#createPublishModuleDefaultTask",
    "description": "Publishes a module",
    "documentation": "https://komore.dev/modules/schematics/executors/publish",
    "factory": "@komore/schematics#createPublishModuleExecutor",
    "options": {
      "processor": "@komore/schematics#publishModuleExecutorOptionsProcessor",
      "schema": "./src/executor/publish/publish-module-executor-options.schema.json"
    }
  }
}
