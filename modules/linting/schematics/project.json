{
  "root": "modules/lint",
  "sourceRoot": "modules/lint/schematics/src",
  "projectType": "library",
  "tags": ["scope:lint", "trait:base"],
  "targets": {
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/lint/schematics",
        "tsConfig": "modules/lint/schematics/tsconfig.lib.json",
        "packageJson": "modules/lint/schematics/package.json",
        "main": "modules/lint/schematics/src/index.ts",
        "assets": ["modules/lint/schematics/executors.json", "modules/lint/schematics/generators.json"]
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/lint/schematics/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/lint-schematics"],
      "options": {
        "jestConfig": "modules/lint/schematics/jest.config.js",
        "passWithNoTests": true
      }
    }
  }
}
