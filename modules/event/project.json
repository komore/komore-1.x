{
  "root": "modules/event",
  "sourceRoot": "modules/event/src",
  "projectType": "library",
  "tags": ["scope:event", "trait:base"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/event/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/event"],
      "options": {
        "jestConfig": "modules/event/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/event",
        "tsConfig": "modules/event/tsconfig.lib.json",
        "packageJson": "modules/event/package.json",
        "main": "modules/event/src/index.ts",
        "assets": ["modules/event/*.md"]
      }
    }
  }
}
