{
  "root": "modules/event/store/amazon/aurora",
  "sourceRoot": "modules/event/store/amazon/aurora/src",
  "projectType": "library",
  "tags": ["scope:event", "scope:event-store", "trait:provider", "provider:amazon"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/event/store/amazon/aurora/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "modules/event/store/amazon/aurora/jest.config.js",
        "passWithNoTests": true,
        "tsConfig": "modules/event/store/amazon/aurora/tsconfig.spec.json"
      },
      "outputs": ["coverage/event-store-amazon-aurora"]
    },
    "build": {
      "executor": "@nrwl/node:package",
      "options": {
        "outputPath": "dist/event/store/amazon/aurora",
        "tsConfig": "modules/event/store/amazon/aurora/tsconfig.lib.json",
        "packageJson": "modules/event/store/amazon/aurora/package.json",
        "main": "modules/event/store/amazon/aurora/src/index.ts",
        "assets": ["modules/event/store/amazon/aurora/*.md"]
      },
      "outputs": ["{options.outputPath}"]
    }
  }
}
