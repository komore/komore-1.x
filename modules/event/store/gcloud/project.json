{
  "root": "modules/event/store/gcloud",
  "sourceRoot": "modules/event/store/gcloud/src",
  "projectType": "library",
  "tags": ["scope:event", "scope:event-store", "trait:provider", "provider:gcloud"],
  "targets": {
    "build": {
      "executor": "@nrwl/node:package",
      "options": {
        "outputPath": "dist/event/store/gcloud",
        "tsConfig": "modules/event/store/gcloud/tsconfig.lib.json",
        "packageJson": "modules/event/store/gcloud/package.json",
        "main": "modules/event/store/gcloud/src/index.ts",
        "assets": ["modules/event/store/gcloud/*.md"]
      },
      "outputs": ["{options.outputPath}"]
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/event/store/gcloud/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "modules/event/store/gcloud/jest.config.js",
        "passWithNoTests": true
      },
      "outputs": ["coverage/event-store-gcloud"]
    }
  }
}
