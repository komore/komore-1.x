{
  "root": "modules/event/store/aws/dynamodb",
  "sourceRoot": "modules/event/store/aws/dynamodb/src",
  "projectType": "library",
  "tags": ["scope:event", "scope:event-store", "trait:provider", "provider:aws"],
  "targets": {
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/event/store/aws/dynamodb",
        "tsConfig": "modules/event/store/aws/dynamodb/tsconfig.lib.json",
        "packageJson": "modules/event/store/aws/dynamodb/package.json",
        "main": "modules/event/store/aws/dynamodb/src/index.ts"
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/event/store/aws/dynamodb/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/event-store-aws-dynamodb"],
      "options": {
        "jestConfig": "modules/event/store/aws/dynamodb/jest.config.js",
        "passWithNoTests": true
      }
    }
  }
}
