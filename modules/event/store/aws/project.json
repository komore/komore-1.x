{
  "root": "modules/event/store/aws",
  "sourceRoot": "modules/event/store/aws/src",
  "projectType": "library",
  "tags": ["scope:event", "scope:event-store", "trait:provider", "provider:aws"],
  "targets": {
    "build": {
      "executor": "@nrwl/node:package",
      "options": {
        "outputPath": "dist/event/store/aws",
        "tsConfig": "modules/event/store/aws/tsconfig.lib.json",
        "packageJson": "modules/event/store/aws/package.json",
        "main": "modules/event/store/aws/src/index.ts",
        "assets": ["modules/event/store/aws/*.md"]
      },
      "outputs": ["{options.outputPath}"]
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/event/store/aws/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "modules/event/store/aws/jest.config.js",
        "passWithNoTests": true
      },
      "outputs": ["coverage/event-store-aws"]
    }
  }
}
