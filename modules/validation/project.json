{
  "root": "modules/validation",
  "sourceRoot": "modules/validation/src",
  "projectType": "library",
  "tags": ["scope:validation", "trait:base"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/validation/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/validation"],
      "options": {
        "jestConfig": "modules/validation/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/validation",
        "tsConfig": "modules/validation/tsconfig.lib.json",
        "packageJson": "modules/validation/package.json",
        "main": "modules/validation/src/index.ts",
        "assets": ["modules/validation/*.md"]
      }
    }
  }
}
