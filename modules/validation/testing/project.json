{
  "root": "modules/validation/testing",
  "sourceRoot": "modules/validation/testing/src",
  "projectType": "library",
  "tags": ["scope:validation", "trait:testing"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/validation/testing/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/validation-testing"],
      "options": {
        "jestConfig": "modules/validation/testing/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/validation/testing",
        "tsConfig": "modules/validation/testing/tsconfig.lib.json",
        "packageJson": "modules/validation/testing/package.json",
        "main": "modules/validation/testing/src/index.ts"
      }
    }
  }
}
