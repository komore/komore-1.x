{
  "root": "modules/identity",
  "sourceRoot": "modules/identity/src",
  "projectType": "library",
  "tags": ["scope:identity", "trait:base"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/identity/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/identity"],
      "options": {
        "jestConfig": "modules/identity/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/identity",
        "tsConfig": "modules/identity/tsconfig.lib.json",
        "packageJson": "modules/identity/package.json",
        "main": "modules/identity/src/index.ts",
        "assets": ["modules/identity/*.md"]
      }
    }
  }
}
