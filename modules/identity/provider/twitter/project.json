{
  "root": "modules/identity/provider/twitter",
  "sourceRoot": "modules/identity/provider/twitter/src",
  "projectType": "library",
  "tags": ["scope:identity", "trait:provider", "provider:twitter"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/identity/provider/twitter/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "modules/identity/provider/twitter/jest.config.js",
        "passWithNoTests": true,
        "tsConfig": "modules/identity/provider/twitter/tsconfig.spec.json"
      },
      "outputs": ["coverage/identity-provider-twitter"]
    },
    "build": {
      "executor": "@nrwl/node:package",
      "options": {
        "outputPath": "dist/identity/provider/twitter",
        "tsConfig": "modules/identity/provider/twitter/tsconfig.lib.json",
        "packageJson": "modules/identity/provider/twitter/package.json",
        "main": "modules/identity/provider/twitter/src/index.ts",
        "assets": ["modules/identity/provider/twitter/*.md"]
      },
      "outputs": ["{options.outputPath}"]
    }
  }
}
