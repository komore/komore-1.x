{
  "root": "modules/identity/provider",
  "sourceRoot": "modules/identity/provider/src",
  "projectType": "library",
  "tags": ["scope:identity", "trait:provider"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/identity/provider/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "modules/identity/provider/jest.config.js",
        "passWithNoTests": true
      },
      "outputs": ["coverage/identity-provider"]
    },
    "build": {
      "executor": "@nrwl/node:package",
      "options": {
        "outputPath": "dist/identity/provider",
        "tsConfig": "modules/identity/provider/tsconfig.lib.json",
        "packageJson": "modules/identity/provider/package.json",
        "main": "modules/identity/provider/src/index.ts"
      },
      "outputs": ["{options.outputPath}"]
    }
  }
}
