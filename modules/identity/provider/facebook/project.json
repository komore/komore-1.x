{
  "root": "modules/identity/provider/facebook",
  "sourceRoot": "modules/identity/provider/facebook/src",
  "projectType": "library",
  "tags": ["scope:identity", "trait:provider", "provider:facebook"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/identity/provider/facebook/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "modules/identity/provider/facebook/jest.config.js",
        "passWithNoTests": true
      },
      "outputs": ["coverage/identity-provider-facebook"]
    },
    "build": {
      "executor": "@nrwl/node:package",
      "options": {
        "outputPath": "dist/identity/provider/facebook",
        "tsConfig": "modules/identity/provider/facebook/tsconfig.lib.json",
        "packageJson": "modules/identity/provider/facebook/package.json",
        "main": "modules/identity/provider/facebook/src/index.ts",
        "assets": ["modules/identity/provider/facebook/*.md"]
      },
      "outputs": ["{options.outputPath}"]
    }
  }
}
