{
  "root": "modules/reactive",
  "sourceRoot": "modules/reactive/src",
  "projectType": "library",
  "tags": ["scope:reactive", "trait:base"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/reactive/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/reactive"],
      "options": {
        "jestConfig": "modules/reactive/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/reactive",
        "tsConfig": "modules/reactive/tsconfig.lib.json",
        "packageJson": "modules/reactive/package.json",
        "main": "modules/reactive/src/index.ts",
        "assets": ["modules/reactive/*.md"]
      }
    }
  }
}
