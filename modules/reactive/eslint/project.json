{
  "root": "modules/reactive/eslint",
  "sourceRoot": "modules/reactive/eslint/src",
  "projectType": "library",
  "tags": ["scope:reactive", "trait:eslint"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/reactive/eslint/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/reactive/eslint"],
      "options": {
        "jestConfig": "modules/reactive/eslint/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/reactive/eslint",
        "tsConfig": "modules/reactive/eslint/tsconfig.lib.json",
        "packageJson": "modules/reactive/eslint/package.json",
        "main": "modules/reactive/eslint/src/index.ts"
      }
    }
  }
}
