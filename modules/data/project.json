{
  "root": "modules/data",
  "sourceRoot": "modules/data/src",
  "projectType": "library",
  "tags": ["scope:data", "trait:base"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/data/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "modules/data/jest.config.js",
        "passWithNoTests": true,
        "tsConfig": "modules/data/tsconfig.spec.json"
      },
      "outputs": ["coverage/data"]
    },
    "build": {
      "executor": "@nrwl/node:package",
      "options": {
        "outputPath": "dist/data",
        "tsConfig": "modules/data/tsconfig.lib.json",
        "packageJson": "modules/data/package.json",
        "main": "modules/data/src/index.ts",
        "assets": ["modules/data/*.md"]
      },
      "outputs": ["{options.outputPath}"]
    }
  }
}
