{
  "root": "modules/regexp",
  "sourceRoot": "modules/regexp/src",
  "projectType": "library",
  "tags": ["scope:regexp", "trait:base"],
  "targets": {
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/regexp",
        "tsConfig": "modules/regexp/tsconfig.lib.json",
        "packageJson": "modules/regexp/package.json",
        "main": "modules/regexp/src/index.ts",
        "assets": ["modules/regexp/*.md"]
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/regexp/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/regexp"],
      "options": {
        "jestConfig": "modules/regexp/jest.config.js",
        "passWithNoTests": true
      }
    }
  }
}
