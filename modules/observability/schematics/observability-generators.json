{
  "$schema": "https://komore.dev/json-schemas/schematics/generators",
  "log-event": {
    "description": "Adds a new log event to a log group",
    "documentation": "https://komore.dev/modules/observability/schematics/generators/log-event",
    "main": "@komore/observability/schematics#logEventGenerator",
    "schema": "./src/generator/log-event/log-event-generator.schema.json"
  },
  "log-group": {
    "description": "Creates a new log group",
    "documentation": "https://komore.dev/modules/observability/schematics/generators/log-group",
    "main": "@komore/observability/schematics#logGroupGenerator",
    "schema": "./src/generator/log-group/log-group-generator.schema.json"
  },
  "metric": {
    "description": "Adds a new metric to a metric group",
    "documentation": "https://komore.dev/modules/observability/schematics/generators/metric",
    "main": "@komore/observability/schematics#logGroupGenerator",
    "schema": "./src/generator/metric/metric-group-generator.schema.json"
  },
  "metric-group": {
    "description": "Creates a new metric group",
    "documentation": "https://komore.dev/modules/observability/schematics/generators/metric-group",
    "main": "@komore/observability/schematics#metricGroupGenerator",
    "schema": "./src/generator/metric-group/metric-group-generator.schema.json"

  }
}
