{
  "root": "modules/observability/tracing",
  "sourceRoot": "modules/observability/tracing/src",
  "projectType": "library",
  "tags": ["scope:observability"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/observability/tracing/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/observability-tracing"],
      "options": {
        "jestConfig": "modules/observability/tracing/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/observability/tracing",
        "tsConfig": "modules/observability/tracing/tsconfig.lib.json",
        "packageJson": "modules/observability/tracing/package.json",
        "main": "modules/observability/tracing/src/index.ts"
      }
    }
  }
}
