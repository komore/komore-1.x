{
  "root": "modules/observability/provider",
  "sourceRoot": "modules/observability/provider/src",
  "projectType": "library",
  "tags": ["scope:observability"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/observability/provider/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/observability-provider"],
      "options": {
        "jestConfig": "modules/observability/provider/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/observability/provider",
        "tsConfig": "modules/observability/provider/tsconfig.lib.json",
        "packageJson": "modules/observability/provider/package.json",
        "main": "modules/observability/provider/src/index.ts"
      }
    }
  }
}
