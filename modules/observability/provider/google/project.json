{
  "root": "modules/observability/provider/google",
  "sourceRoot": "modules/observability/provider/google/src",
  "projectType": "library",
  "tags": ["scope:observability", "trait:provider", "provider:google"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/observability/provider/google/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/observability-provider-google"],
      "options": {
        "jestConfig": "modules/observability/provider/google/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/observability-provider-google",
        "tsConfig": "modules/observability/provider/google/tsconfig.lib.json",
        "packageJson": "modules/observability/provider/google/package.json",
        "main": "modules/observability/provider/google/src/index.ts",
        "assets": ["modules/observability/provider/google/*.md"]
      }
    }
  }
}
