{
  "root": "modules/integration/aws/route-53",
  "sourceRoot": "modules/integration/aws/route-53/src",
  "projectType": "library",
  "tags": ["scope:integration", "trait:provider", "provider:aws"],
  "targets": {
    "build": {
      "executor": "@nrwl/node:package",
      "options": {
        "outputPath": "dist/integration/aws/route-53",
        "tsConfig": "modules/integration/aws/route-53/tsconfig.lib.json",
        "packageJson": "modules/integration/aws/route-53/package.json",
        "main": "modules/integration/aws/route-53/src/index.ts"
      },
      "outputs": ["{options.outputPath}"]
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/integration/aws/route-53/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "modules/integration/aws/route-53/jest.config.js",
        "passWithNoTests": true
      },
      "outputs": ["coverage/integration-aws-route53"]
    }
  }
}
