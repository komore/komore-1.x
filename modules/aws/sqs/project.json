{
  "root": "modules/integration/aws/sqs",
  "sourceRoot": "modules/integration/aws/sqs/src",
  "projectType": "library",
  "tags": ["scope:integration", "trait:provider", "provider:aws"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/integration/aws/sqs/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/integration-aws-sqs"],
      "options": {
        "jestConfig": "modules/integration/aws/sqs/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/integration/aws/sqs",
        "tsConfig": "modules/integration/aws/sqs/tsconfig.lib.json",
        "packageJson": "modules/integration/aws/sqs/package.json",
        "main": "modules/integration/aws/sqs/src/index.ts"
      }
    }
  }
}
