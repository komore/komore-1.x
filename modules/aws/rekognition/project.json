{
  "root": "modules/integration/aws/rekognition",
  "sourceRoot": "modules/integration/aws/rekognition/src",
  "projectType": "library",
  "tags": ["scope:integration", "trait:provider", "provider:aws"],
  "targets": {
    "build": {
      "executor": "@nrwl/node:package",
      "options": {
        "outputPath": "dist/integration/aws/rekognition",
        "tsConfig": "modules/integration/aws/rekognition/tsconfig.lib.json",
        "packageJson": "modules/integration/aws/rekognition/package.json",
        "main": "modules/integration/aws/rekognition/src/index.ts"
      },
      "outputs": ["{options.outputPath}"]
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/integration/aws/rekognition/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "modules/integration/aws/rekognition/jest.config.js",
        "passWithNoTests": true
      },
      "outputs": ["coverage/integration-aws-rekognition"]
    }
  }
}
