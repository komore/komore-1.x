{
  "root": "modules/cli/publish",
  "sourceRoot": "modules/cli/publish/src",
  "projectType": "library",
  "tags": ["scope:cli"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/cli/publish/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/cli-publish"],
      "options": {
        "jestConfig": "modules/cli/publish/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/cli/publish",
        "tsConfig": "modules/cli/publish/tsconfig.lib.json",
        "packageJson": "modules/cli/publish/package.json",
        "main": "modules/cli/publish/src/index.ts"
      }
    }
  }
}
