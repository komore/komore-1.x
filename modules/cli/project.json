{
  "root": "modules/cli",
  "sourceRoot": "modules/cli/src",
  "projectType": "application",
  "tags": ["scope:cli", "trait:base"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/cli/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/cli"],
      "options": {
        "jestConfig": "modules/cli/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/cli",
        "tsConfig": "modules/cli/tsconfig.app.json",
        "packageJson": "modules/cli/package.json",
        "main": "modules/cli/src/index.ts",
        "assets": [
          "modules/cli/*.md",
          {
            "glob": "*",
            "input": "modules/cli/bin",
            "output": "/bin"
          }
        ]
      }
    }
  }
}
