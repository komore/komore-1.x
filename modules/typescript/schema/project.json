{
  "root": "modules/typescript/schema",
  "sourceRoot": "modules/typescript/schema/src",
  "projectType": "library",
  "tags": ["scope:typescript"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/typescript/schema/src/**/*.ts"]
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/typescript/schema",
        "tsConfig": "modules/typescript/schema/tsconfig.lib.json",
        "packageJson": "modules/typescript/schema/package.json",
        "main": "modules/typescript/schema/src/index.ts"
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/typescript-schema"],
      "options": {
        "jestConfig": "modules/typescript/schema/jest.config.js",
        "passWithNoTests": true
      }
    }
  }
}
