{
  "root": "modules/typescript",
  "sourceRoot": "modules/typescript/src",
  "projectType": "library",
  "tags": ["scope:typescript", "trait:base"],
  "targets": {
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/typescript",
        "tsConfig": "modules/typescript/tsconfig.lib.json",
        "packageJson": "modules/typescript/package.json",
        "main": "modules/typescript/src/index.ts",
        "assets": ["modules/typescript/*.md"]
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/typescript/src/**/*.ts"]
      }
    },
    "publish": {
      "executor": "@komore/nx:publish",
      "packageJson": "modules/typescript/package.json",
      "buildTarget": ["typescript:build", "typescript-schema:build"]
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/typescript"],
      "options": {
        "jestConfig": "modules/typescript/jest.config.js",
        "passWithNoTests": true
      }
    }
  }
}
