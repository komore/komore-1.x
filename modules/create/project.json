{
  "root": "modules/create",
  "sourceRoot": "modules/create/src",
  "projectType": "library",
  "tags": ["scope:create", "trait:cli"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/create/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/create"],
      "options": {
        "jestConfig": "modules/create/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/create",
        "tsConfig": "modules/create/tsconfig.lib.json",
        "packageJson": "modules/create/package.json",
        "main": "modules/create/src/index.ts",
        "assets": ["modules/create/*.md"]
      }
    }
  }
}
