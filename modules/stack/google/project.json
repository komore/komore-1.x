{
  "root": "modules/stack/google",
  "sourceRoot": "modules/stack/google/src",
  "projectType": "library",
  "tags": ["scope:stack", "trait:provider", "provider:google"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/stack/google/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/stack-google"],
      "options": {
        "jestConfig": "modules/stack/google/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/stack-google",
        "tsConfig": "modules/stack/google/tsconfig.lib.json",
        "packageJson": "modules/stack/google/package.json",
        "main": "modules/stack/google/src/index.ts"
      }
    }
  }
}
