{
  "root": "modules/stack/schematics",
  "sourceRoot": "modules/stack/schematics/src",
  "projectType": "library",
  "tags": ["scope:stack", "trait:provider", "provider:schematics"],
  "targets": {
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/stack/schematics",
        "tsConfig": "modules/stack/schematics/tsconfig.lib.json",
        "packageJson": "modules/stack/schematics/package.json",
        "main": "modules/stack/schematics/src/index.ts",
        "assets": [
          "modules/stack/schematics/commands.json",
          "modules/stack/schematics/executors.json",
          "modules/stack/schematics/generators.json"
        ]
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/stack/schematics/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/stack-schematics"],
      "options": {
        "jestConfig": "modules/stack/schematics/jest.config.js",
        "passWithNoTests": true
      }
    }
  }
}
