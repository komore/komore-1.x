    "main": "@komore/stack/schematics#stackInitializationGenerator",
    "schema": "./src/generator/init/init-stack-generator.schema.json",
    "triggers": ["post-install"]
  },
  "stack": {
    "description": "Creates a stack project",
    "documentation": "https://komore.dev/modules/stack/schematics/generators/stack",
