{
  "root": "modules/stack",
  "sourceRoot": "modules/stack/src",
  "projectType": "library",
  "tags": ["scope:stack", "trait:provider"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/stack/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/stack"],
      "options": {
        "jestConfig": "modules/stack/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/stack",
        "tsConfig": "modules/stack/tsconfig.lib.json",
        "packageJson": "modules/stack/package.json",
        "main": "modules/stack/src/index.ts",
        "assets": ["modules/stack/*.md"]
      }
    }
  }
}
