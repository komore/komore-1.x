{
  "root": "modules/stack/gcloud",
  "sourceRoot": "modules/stack/gcloud/src",
  "projectType": "library",
  "tags": ["scope:stack", "trait:provider", "provider:gcloud"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/stack/gcloud/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/stack-gcloud"],
      "options": {
        "jestConfig": "modules/stack/gcloud/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/stack-gcloud",
        "tsConfig": "modules/stack/gcloud/tsconfig.lib.json",
        "packageJson": "modules/stack/gcloud/package.json",
        "main": "modules/stack/gcloud/src/index.ts"
      }
    }
  }
}
