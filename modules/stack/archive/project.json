{
  "root": "modules/stack/archive",
  "sourceRoot": "modules/stack/archive/src",
  "projectType": "library",
  "tags": ["scope:stack", "trait:provider", "provider:archive"],
  "targets": {
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["modules/stack/archive/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/stack-archive"],
      "options": {
        "jestConfig": "modules/stack/archive/jest.config.js",
        "passWithNoTests": true
      }
    },
    "build": {
      "executor": "@nrwl/node:package",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/stack/archive",
        "tsConfig": "modules/stack/archive/tsconfig.lib.json",
        "packageJson": "modules/stack/archive/package.json",
        "main": "modules/stack/archive/src/index.ts"
      }
    }
  }
}
