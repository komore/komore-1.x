  "scripts": {
    "build": "nx run-many --all --target=build --parallel",
    "build:affected": "nx affected:build",
    "cdktf:generate": "ts-node ./tools/cdk/generate-cdk-files.ts ./tmp/cdktf ./modules/stack",
    "dep-graph": "nx dep-graph",
    "dep-graph:affected": "nx affected:dep-graph",
    "e2e": "nx e2e",
    "e2e:affected": "nx affected:e2e",
    "lint": "nx run-many --all --target=lint --parallel",
    "lint:affected": "nx affected:lint",
    "lint:workspace": "nx workspace-lint",
    "serve:website": "rollup --config modules/website/rollup.config.ts --configPlugin typescript -w",
    "serve:vscode": "nx build vscode --no-cache --watch",
    "test": "nx run-many --all --target=test --parallel",
    "test:affected": "nx affected:test",
    "tools:generate-website-tree": "ts-node ./tools/generate-website-tree.ts ./docs/modules"
  },
