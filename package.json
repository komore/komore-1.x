{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@komore/root",
  "version": "0.0.0",
  "private": true,
  "keywords": [
    "komore",
    "framework",
    "typescript"
  ],
  "homepage": "https://komore.dev",
  "bugs": {
    "url": "https://github.com/komore/komore/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Michael Putters",
    "url": "https://github.com/rraziel"
  },
  "contributors": [],
  "repository": {
    "type": "github",
    "url": "https://github.com/komore/komore"
  },
  "scripts": {
    "build": "pnpm k build --affected",
    "build:all": "k build --project=*",
    "k": "ts-node --swc --project ./modules/k/k.tsconfig.application.json -r tsconfig-paths/register ./modules/k/src/index.ts",
    "k:ts": "ts-node --project ./modules/k/k.tsconfig.application.json -r tsconfig-paths/register ./modules/k/src/index.ts",
    "lint": "pnpm k run lint --all",
    "lint:affected": "pnpm k run lint --affected",
    "lint:workspace": "pnpm k run lint --workspace",
    "overview": "k overview",
    "serve:website": "rollup --config modules/website/rollup.config.ts --configPlugin typescript -w",
    "serve:vscode": "k build vscode --no-cache --watch",
    "test": "k test --affected",
    "test:all": "k test --project=*",
    "tools:documentation": "ts-node -r tsconfig-paths/register --project ./tools/documentation/tsconfig.json ./tools/documentation/src/index.ts",
    "tools:website:generate-tree": "ts-node -r tsconfig-paths/register --project ./tools/website/tsconfig.json ./tools/website/src/generate-website-tree.ts ./docs/modules",
    "x:api": "ts-node --project ./tools/api/tsconfig.json -r tsconfig-paths/register ./tools/api/src/api.ts",
    "x:aws": "ts-node --project ./tools/aws/tsconfig.json -r tsconfig-paths/register ./tools/aws/src/aws.ts",
    "x:cd": "ts-node --project ./tools/cd/tsconfig.json -r tsconfig-paths/register ./tools/cd/src/cd.ts",
    "x:crypto": "ts-node --project ./tools/crypto/tsconfig.json -r tsconfig-paths/register ./tools/crypto/src/crypto.ts",
    "x:discord": "ts-node --project ./tools/discord/tsconfig.json -r tsconfig-paths/register ./tools/discord/src/discord.ts",
    "x:documentation": "ts-node --project ./tools/documentation/tsconfig.json -r tsconfig-paths/register ./tools/documentation/src/documentation.ts",
    "x:etoro": "ts-node --project ./tools/etoro/tsconfig.json -r tsconfig-paths/register ./tools/etoro/src/etoro.ts",
    "x:git": "ts-node --project ./tools/git/tsconfig.json -r tsconfig-paths/register ./tools/git/src/git.ts",
    "x:github": "ts-node --project ./tools/github/tsconfig.json -r tsconfig-paths/register ./tools/github/src/github.ts",
    "x:gitlab": "ts-node --project ./tools/gitlab/tsconfig.json -r tsconfig-paths/register ./tools/gitlab/src/gitlab.ts",
    "x:notion": "ts-node --project ./tools/notion/tsconfig.json -r tsconfig-paths/register ./tools/notion/src/notion.ts",
    "x:poetry": "ts-node --project ./tools/poetry/tsconfig.json -r tsconfig-paths/register ./tools/poetry/src/poetry.ts",
    "x:slack": "ts-node --project ./tools/slack/tsconfig.json -r tsconfig-paths/register ./tools/slack/src/slack.ts",
    "x:teams": "ts-node --project ./tools/teams/tsconfig.json -r tsconfig-paths/register ./tools/teams/src/teams.ts",
    "x:terraform": "ts-node --project ./tools/terraform/tsconfig.json -r tsconfig-paths/register ./tools/terraform/src/terraform.ts",
    "x:test": "ts-node --project ./tools/test/tsconfig.json -r tsconfig-paths/register ./tools/test/src/test.ts"
  },
  "devDependencies": {
    "@cucumber/gherkin": "28.0.0",
    "@cucumber/messages": "24.0.1",
    "@electron/remote": "2.1.2",
    "@js-temporal/polyfill": "0.4.4",
    "@messageformat/core": "3.3.0",
    "@opentelemetry/api": "1.8.0",
    "@opentelemetry/core": "1.22.0",
    "@opentelemetry/resources": "1.22.0",
    "@opentelemetry/sdk-trace-base": "1.22.0",
    "@opentelemetry/sdk-trace-node": "1.22.0",
    "@opentelemetry/sdk-trace-web": "1.22.0",
    "@opentelemetry/semantic-conventions": "1.22.0",
    "@stylistic/eslint-plugin-ts": "1.7.0",
    "@swc/core": "1.4.8",
    "@types/aws-lambda": "8.10.136",
    "@types/dom-mediacapture-record": "1.0.19",
    "@types/dom-screen-wake-lock": "1.0.3",
    "@types/dom-speech-recognition": "0.0.4",
    "@types/eslint": "8.56.5",
    "@types/jsdom": "21.1.6",
    "@types/node": "20.11.27",
    "@types/trusted-types": "2.0.7",
    "@types/vscode": "1.87.0",
    "@types/webxr": "0.5.14",
    "@typescript-eslint/eslint-plugin": "7.2.0",
    "@typescript-eslint/experimental-utils": "5.62.0",
    "@typescript-eslint/parser": "7.2.0",
    "@webgpu/types": "0.1.40",
    "avsc": "5.7.7",
    "electron": "29.1.4",
    "esbuild": "0.20.1",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "fast-xml-parser": "4.3.5",
    "intl-messageformat": "10.5.11",
    "jsdom": "24.0.0",
    "jsonwebtoken": "9.0.2",
    "marked": "12.0.1",
    "neo4j-driver": "5.18.0",
    "path-to-regexp": "6.2.1",
    "prettier": "3.2.5",
    "rxjs": "7.8.1",
    "stripe": "14.20.0",
    "ts-morph": "22.0.0",
    "tslib": "2.6.2",
    "tsconfig-paths": "4.2.0",
    "ts-node": "10.9.2",
    "typescript": "5.4.2",
    "yaml": "2.4.1",
    "yoga-layout": "3.0.0"
  }
}
