{
  "version": "0.2.0",
  "configurations":[
    {
      "name": "VS Code Extension",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/dist/vscode/extension"
      ],
      "outFiles": [
        "${workspaceFolder}/dist/vscode/extension/**/*.js"
      ],
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "type": "extensionHost",
      "preLaunchTask": "build-vscode-watch"
    }
  ]
}
