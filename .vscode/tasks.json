{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-vscode-extension-watch",
      "type": "shell",
      "command": "pnpm",
      "args": ["k:ts", "build", "vscode-extension", "--no-cache", "--watch"],
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "fileLocation": "relative",
        "pattern": {
          "regexp": "^([^:]+):(\\d+:\\d+)\\s+-\\s+(error|warning|info)\\s+(TS\\d+):\\s*(.*)$",
          "file": 1,
          "location": 2,
          "severity": 3,
          "code": 4,
          "message": 5
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting",
          "endsPattern": "\\[[^\\.]+\\. Watching for file changes."
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
