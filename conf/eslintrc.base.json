{
  "$schema": "https://json.schemastore.org/eslintrc.json",
  "root": true,
  "ignorePatterns": ["**/*"],
  "parser": "@typescript-eslint/parser",
  "plugins": ["@stylistic/eslint-plugin-ts", "@typescript-eslint"],
  "overrides": [
    {
      "files": ["*.ts"],
      "extends": [],
      "rules": {
        "no-param-reassign": ["error", { "props": true }],
        "no-unused-labels": ["off"],
        "one-var": [
          "error",
          {
            "const": "never",
            "let": "never",
            "var": "never"
          }
        ],
        "@stylistic/ts/block-spacing": ["error", "always"],
        "@stylistic/ts/brace-style": ["error", "1tbs"],
        "@stylistic/ts/comma-spacing": ["error", { "after": true, "before": false }],
        "@stylistic/ts/function-call-spacing": ["error", "never"],
        "@stylistic/ts/key-spacing": [
          "error",
          {
            "afterColon": true,
            "beforeColon": false
          }
        ],
        "@stylistic/ts/keyword-spacing": [
          "error",
          {
            "after": true,
            "before": true
          }
        ],
        "@stylistic/ts/member-delimiter-style": [
          "error",
          {
            "multiline": {
              "delimiter": "semi",
              "requireLast": true
            },
            "singleline": {
              "delimiter": "comma",
              "requireLast": false
            }
          }
        ],
        "@typescript-eslint/adjacent-overload-signatures": ["error"],
        "@typescript-eslint/array-type": [
          "error",
          {
            "default": "generic"
          }
        ],
        "@typescript-eslint/await-thenable": ["error"],
        "@typescript-eslint/ban-ts-comment": ["error"],
        "@typescript-eslint/ban-types": [
          "error",
          {
            "types": {
              "{}": false
            }
          }
        ],
        "@typescript-eslint/consistent-type-imports": [
          "error",
          {
            "disallowTypeAnnotations": true,
            "fixStyle": "inline-type-imports",
            "prefer": "type-imports"
          }
        ],
        "@typescript-eslint/no-unused-vars": [
          "error",
          {
            "argsIgnorePattern": "^_",
            "varsIgnorePattern": "^_"
          }
        ],
        "@typescript-eslint/prefer-readonly-parameter-types": [
          "error",
          {
            "allow": [
              { "from": "lib", "name": "AddEventListenerOptions" },
              { "from": "lib", "name": "CryptoKey" },
              { "from": "lib", "name": "FileReader" },
              { "from": "lib", "name": "MessageEvent" },
              { "from": "lib", "name": "PropertyDescriptorMap" },
              { "from": "lib", "name": "RegExp" },
              { "from": "lib", "name": "RequestInit" },
              { "from": "lib", "name": "Uint8Array" },
              { "from": "lib", "name": "URL" },
              { "from": "package", "name": "Observable", "package": "rxjs" },
              { "from": "package", "name": "Subject", "package": "rxjs" }
            ],
            "ignoreInferredTypes": true,
            "treatMethodsAsReadonly": true
          }
        ]
      }
    }
  ]
}
