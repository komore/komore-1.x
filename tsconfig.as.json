{
  "compileOnSave": false,
  "compilerOptions": {
    "allowJs": false,
    "baseUrl": ".",
    "experimentalDecorators": true,
    "module": "commonjs",
    "noEmitOnError": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noLib": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "rootDir": ".",
    "strict": true,
    "strictNullChecks": true,
    "target": "ESNext",
    "typeRoots": [
      "node_modules/assemblyscript/std/types"
    ],
    "types": ["assembly"]
  }
}
