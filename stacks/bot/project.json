{
  "projectType": "application",
  "root": "stacks/bot",
  "sourceRoot": "stacks/bot/src",
  "tags": ["scope:stacks", "stack:bot"],
  "targets": {
    "build": {
      "executor": "@nrwl/node:package",
      "options": {
        "assets": [],
        "main": "stacks/bot/src/main.ts",
        "outputPath": "dist/stacks/bot",
        "project": "stacks/bot/package.json",
        "tsConfig": "stacks/bot/tsconfig.stack.json"
      },
      "outputs": ["{options.outputPath}"]
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["stacks/bot/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "stacks/bot/jest.config.js",
        "passWithNoTests": true
      },
      "outputs": ["coverage/stacks-bot"]
    }
  }
}
