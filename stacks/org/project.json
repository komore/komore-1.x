{
  "projectType": "application",
  "root": "stacks/org",
  "sourceRoot": "stacks/org/src",
  "tags": ["scope:stacks", "stack:org"],
  "targets": {
    "build": {
      "executor": "@nrwl/node:package",
      "options": {
        "assets": [],
        "main": "stacks/org/src/main.ts",
        "outputPath": "dist/stacks/org",
        "project": "stacks/org/package.json",
        "tsConfig": "stacks/org/tsconfig.stack.json"
      },
      "outputs": ["{options.outputPath}"]
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["stacks/org/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "stacks/org/jest.config.js",
        "passWithNoTests": true
      },
      "outputs": ["coverage/stacks-org"]
    }
  }
}
