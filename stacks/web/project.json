{
  "projectType": "application",
  "root": "stacks/web",
  "sourceRoot": "stacks/web/src",
  "tags": ["scope:stacks", "stack:web"],
  "targets": {
    "build": {
      "executor": "@nrwl/node:package",
      "options": {
        "assets": [],
        "entryFile": "stacks/web/src/main.ts",
        "outputPath": "dist/stacks/web",
        "project": "stacks/web/package.json",
        "tsConfig": "stacks/web/tsconfig.stack.json"
      },
      "outputs": ["{options.outputPath}"]
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "options": {
        "lintFilePatterns": ["stacks/web/src/**/*.ts"]
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "options": {
        "jestConfig": "stacks/web/jest.config.js",
        "passWithNoTests": true
      },
      "outputs": ["coverage/stacks-web"]
    }
  }
}
