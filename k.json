{
  "defaults": {
    "project": "website"
  },
  "domains": {
    "string": {},
    "temporal": {}
  },
  "layout": {
    "applications": "modules",
    "libraries": "modules",
    "stacks": "stacks"
  },
  "package": {
    "manager": "pnpm",
    "scope": "komore"
  },
  "projects": {
    "application": "modules/application",
    "array": "modules/array",
    "bot-stack": "stacks/bot",
    "cli": "modules/cli",
    "ci-stack": "stacks/ci",
    "color": "modules/color",
    "command": "modules/command",
    "create": "modules/create",
    "crypto": "modules/crypto",
    "documentation": "modules/documentation",
    "element": "modules/element",
    "event": "modules/event",
    "functional": "modules/functional",
    "init-stack": "stacks/init",
    "json": "modules/json",
    "math": "modules/math",
    "regexp": "modules/regexp",
    "string": "modules/string",
    "temporal": "modules/temporal",
    "typescript": "modules/typescript",
    "validation": "modules/validation",
    "validation-testing": "modules/validation/testing",
    "vscode-extension": "modules/vscode-extension",
    "web": "modules/web",
    "website": "modules/website",
    "website-stack": "stacks/website",
    "yaml": "modules/yaml"
  },
  "schematics": {
    "@komore/schematics": {
      "executors": {
        "publish": {}
      }
    },
    "@komore/testing": {
      "executors": {
        "test": {
          "coverage": {
            "formats": ["lcov"]
          }
        }
      }
    }
  },
  "task": {
    "defaults": {
      "build": "@komore/schematics:build",
      "deploy": "@komore/stack:deploy",
      "document": "@komore/documentation:document",
      "lint": "@komore/linting:lint",
      "test": "@komore/testing:test",
      "package": "@komore/schematics:package",
      "publish": "@komore/schematics:publish"
    },
    "runner": "@komore/schematics/runner#createTaskRunner",
    "options": {
      "cacheable": ["build", "document", "lint", "package", "test"],
      "parallel": 1
    }
  },
  "version": "@komore/schematics#1.0.0"
}
